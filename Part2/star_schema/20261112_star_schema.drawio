        <mxCell id="note_2" value="Aggregation: Station-wide availability totals repeat across type entries. Do not sum these rows as independent station observations." style="text;html=0;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=15;fontColor=#334656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="916" width="1680" height="32" />
        </mxCell>
        <mxCell id="note_3" value="Keys and history: Lines show SQL joins, not enforced database PK/FK constraints. No Type 2 station history or separate vehicle-availability dimension." style="text;html=0;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=15;fontColor=#334656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="949" width="1680" height="32" />
        </mxCell>
        <mxCell id="note_4" value="Types: Types follow dbt SQL and Bronze DDL. Ride coordinates remain VARCHAR; confirm deployed types with information_schema.columns." style="text;html=0;align=left;whiteSpace=wrap;verticalAlign=middle;fontSize=15;fontColor=#334656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="982" width="1680" height="32" />
